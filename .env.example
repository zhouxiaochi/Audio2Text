# OpenRouter-compatible API
REMOTE_BASE_URL=https://openrouter.ai/api/v1
REMOTE_API_KEY=replace-with-your-api-key
TRANSCRIPTION_MODEL=openai/whisper-large-v3
SPEAKER_MODEL=openai/gpt-5-mini
LLM_MODEL=openai/gpt-5

# Backend
DATA_DIR=./data
DATABASE_PATH=./data/audio2text.sqlite3
MAX_UPLOAD_BYTES=524288000
CHUNK_SECONDS=480
OVERLAP_SECONDS=8
FRONTEND_ORIGIN=http://localhost:3000
MAX_ACTIVE_JOBS=1
RETENTION_HOURS=24

# Frontend (put this in frontend/.env.local when overriding)
NEXT_PUBLIC_API_URL=http://localhost:8000
