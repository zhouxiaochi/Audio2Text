# DigitalOcean Managed MongoDB. Keep real values in .env.mongo or DO Secrets.
MONGODB_URI=mongodb+srv://username:password@cluster.example.com/?authSource=admin
MONGODB_DATABASE=audio2text

# Generate a long, random value and set it as a DO Secret.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_DAYS=14
MINIMUM_UPLOAD_CREDIT_USD=1.00

# Created once when no matching user exists. Set both as DO Secrets.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password
